{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UniversalEventSchema",
  "$comment": "v1.2.0 - Added schema_version, tenant_id, vendor_attributes, and OCSF/ECS taxonomy alignment",
  "type": "object",
  "required": ["event_id", "ingest_timestamp", "raw", "source", "event", "lineage"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "string"},
    "tenant_id": {"type": "string"},
    "event_id": {"type": "string"},
    "ingest_timestamp": {"type": "string"},
    "source_event_timestamp": {"type": ["string", "null"]},
    "raw": {
      "type": "object",
      "required": ["raw_payload", "raw_format", "raw_hash"],
      "additionalProperties": false,
      "properties": {
        "raw_payload": {"type": "string"},
        "raw_format": {"type": "string"},
        "raw_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "source": {
      "type": "object",
      "required": ["log_format"],
      "additionalProperties": false,
      "properties": {
        "vendor": {"type": ["string", "null"]},
        "product": {"type": ["string", "null"]},
        "device_hostname": {"type": ["string", "null"]},
        "source_ip": {"type": ["string", "null"]},
        "log_format": {"type": "string"}
      }
    },
    "event": {
      "type": "object",
      "required": ["category"],
      "additionalProperties": true,
      "properties": {
        "category": {
          "type": "string",
          "enum": ["network", "authentication", "threat", "system", "policy", "api", "database", "unknown"]
        },
        "class_name": {"type": ["string", "null"]},
        "class_uid": {"type": ["integer", "null"]},
        "activity_name": {"type": ["string", "null"]},
        "activity_id": {"type": ["integer", "null"]},
        "action": {"type": ["string", "null"]},
        "outcome": {"type": ["string", "null"], "enum": ["success", "failure", "unknown", null]},
        "severity_numeric": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
        "severity_original": {"type": ["string", "null"]},
        "severity_inferred": {"type": ["boolean", "null"]},
        "event_type_vendor_specific": {"type": ["string", "null"]}
      }
    },
    "network": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "src_ip": {"type": ["string", "null"]},
        "src_port": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535},
        "dst_ip": {"type": ["string", "null"]},
        "dst_port": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535},
        "protocol": {"type": ["string", "null"]},
        "bytes_in": {"type": ["integer", "null"], "minimum": 0},
        "bytes_out": {"type": ["integer", "null"], "minimum": 0},
        "direction": {
          "type": ["string", "null"],
          "enum": ["inbound", "outbound", "internal", "unknown", null]
        },
        "interface": {"type": ["string", "null"]}
      }
    },
    "identity": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "username": {"type": ["string", "null"]},
        "user_domain": {"type": ["string", "null"]}
      }
    },
    "rule": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "rule_id": {"type": ["string", "null"]},
        "rule_name": {"type": ["string", "null"]},
        "policy_action": {"type": ["string", "null"]}
      }
    },
    "vendor_attributes": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "enrichment": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "geo_src": {"type": ["object", "null"]},
        "geo_dst": {"type": ["object", "null"]},
        "threat_intel_tags": {"type": ["array", "null"], "items": {"type": "string"}},
        "src_ip_context": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "properties": {
            "ip": {"type": "string"},
            "ip_type": {"type": "string", "enum": ["private", "public", "loopback", "link_local", "multicast", "invalid"]},
            "is_internal": {"type": ["boolean", "null"]},
            "is_public": {"type": ["boolean", "null"]},
            "is_threat": {"type": ["boolean", "null"]},
            "threat_intel": {"type": ["array", "null"], "items": {"type": "string"}},
            "cloud_provider": {"type": ["string", "null"]},
            "cloud_service": {"type": ["string", "null"]}
          }
        },
        "dst_ip_context": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "properties": {
            "ip": {"type": "string"},
            "ip_type": {"type": "string"},
            "is_internal": {"type": ["boolean", "null"]},
            "is_public": {"type": ["boolean", "null"]},
            "is_threat": {"type": ["boolean", "null"]}
          }
        },
        "threat_ip_detected": {"type": ["boolean", "null"]}
      }
    },
    "analytics": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "anomaly_score": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "anomaly_reasons": {"type": "array", "items": {"type": "string"}},
        "is_anomalous": {"type": "boolean"},
        "risk_score": {"type": "number", "minimum": 0.0, "maximum": 10.0}
      }
    },
    "lineage": {
      "type": "object",
      "required": ["parser_name", "parser_version", "normalization_ruleset_version"],
      "additionalProperties": false,
      "properties": {
        "parser_name": {"type": "string"},
        "parser_version": {"type": "string"},
        "normalization_ruleset_version": {"type": "string"}
      }
    }
  }
}
