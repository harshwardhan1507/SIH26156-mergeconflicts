<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Universal Log Pre-processing Framework (ULPF)"
           Manufacturer="NotUrNio"
           Version="1.2.0.0"
           UpgradeCode="4C5E8D2A-7F1B-4A9E-8B3C-1D5E9F7A2B4C"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of ULPF is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ULPF">
        <Component Id="ULPFLauncherExe" Guid="1F8E3C5A-9D7F-4E2B-8C1A-5F9E7D3A2B1C">
          <File Id="ULPFLauncherExeFile" Source="dist\ULPF-Launcher.exe" KeyPath="yes" />
        </Component>

        <Component Id="ULPFCliExe" Guid="2F8E3C5A-9D7F-4E2B-8C1A-5F9E7D3A2B1D">
          <File Id="ULPFCliExeFile" Source="dist\ulpf.exe" KeyPath="yes" />
        </Component>

        <Component Id="ULPFDashboardExe" Guid="3F8E3C5A-9D7F-4E2B-8C1A-5F9E7D3A2B1E">
          <File Id="ULPFDashboardExeFile" Source="dist\ulpf-dashboard.exe" KeyPath="yes" />
        </Component>

        <Component Id="AppIconFile" Guid="4F8E3C5A-9D7F-4E2B-8C1A-5F9E7D3A2B1F">
          <File Id="IconIcoFile" Source="packaging\windows\ulpf_icon.ico" KeyPath="yes" />
        </Component>

        <Component Id="ReadmeFile" Guid="5F8E3C5A-9D7F-4E2B-8C1A-5F9E7D3A2B20">
          <File Id="ReadmeMdFile" Source="README.md" KeyPath="yes" />
        </Component>

        <Component Id="LicenseFile" Guid="6F8E3C5A-9D7F-4E2B-8C1A-5F9E7D3A2B21">
          <File Id="LicenseTxtFile" Source="LICENSE" KeyPath="yes" />
        </Component>

        <Component Id="EnvPath" Guid="7F8E3C5A-9D7F-4E2B-8C1A-5F9E7D3A2B22" KeyPath="yes">
          <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="ULPF">
        <Component Id="ApplicationShortcut" Guid="8F8E3C5A-9D7F-4E2B-8C1A-5F9E7D3A2B23">
          <Shortcut Id="StartMenuShortcut"
                    Name="ULPF Operations Dashboard"
                    Description="Launch ULPF Operations Dashboard"
                    Target="[INSTALLFOLDER]ULPF-Launcher.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon" />
          <Shortcut Id="StartMenuCliShortcut"
                    Name="ULPF Command Line"
                    Description="ULPF CLI &amp; Interactive Launcher"
                    Target="[INSTALLFOLDER]ulpf.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon" />
          <RemoveFolder Id="CleanUpShortCut" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\NotUrNio\ULPF" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="9F8E3C5A-9D7F-4E2B-8C1A-5F9E7D3A2B24">
        <Shortcut Id="DesktopShortcut"
                  Name="ULPF Operations Dashboard"
                  Description="Launch ULPF Operations Dashboard"
                  Target="[INSTALLFOLDER]ULPF-Launcher.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\NotUrNio\ULPF" Name="desktop_installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Icon Id="AppIcon" SourceFile="packaging\windows\ulpf_icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/NotUrNio/ULPF" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/NotUrNio/ULPF" />

    <Feature Id="MainFeature" Title="ULPF Core" Level="1">
      <ComponentRef Id="ULPFLauncherExe" />
      <ComponentRef Id="ULPFCliExe" />
      <ComponentRef Id="ULPFDashboardExe" />
      <ComponentRef Id="AppIconFile" />
      <ComponentRef Id="ReadmeFile" />
      <ComponentRef Id="LicenseFile" />
      <ComponentRef Id="EnvPath" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>
  </Package>
</Wix>
