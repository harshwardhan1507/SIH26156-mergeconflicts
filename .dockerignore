# Keeps the build context small and air-gap-clean. The builder stage runs
# `COPY . .`, so anything listed here never enters the image.

.git/
.github/

# Host virtual environments — never ship these into the build context
env/
venv/
.venv/
ENV/

# Build and cache artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Pipeline run outputs and local databases
output/
output_*/
benchmark_output/
*.db
*.sqlite
*.sqlite3

# Not needed inside the image
docs/
tests/
scripts/
tools/
CHANGELOG.md
*.bat
*.vbs

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
