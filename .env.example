# ==============================================================================
# Universal Log Pre-processing Framework (ULPF) — Environment Configuration
# Copy this file to .env and configure your deployment settings.
# Never commit real credentials or API keys to version control.
# ==============================================================================

# Dashboard Security & Access Control
ULPF_API_KEY=
ULPF_CORS_ORIGINS=http://127.0.0.1:7000,http://localhost:7000

# Pipeline Paths & Storage Configuration
ULPF_OUTPUT_DIR=output
ULPF_DATA_DIR=
ULPF_SOURCES_DIR=

# Optional Live Database Security Probe (Left empty to skip live probe)
ULPF_PROBE_MYSQL_HOST=
ULPF_PROBE_MYSQL_PORT=3306
ULPF_PROBE_MYSQL_USER=
ULPF_PROBE_MYSQL_PASSWORD=
